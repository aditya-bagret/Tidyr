// SCHEMA.md §6, adapted to Prisma 7: the `prisma-client` generator writes the client into src/ and
// the connection URL lives in prisma.config.ts (the runtime connects through @prisma/adapter-pg).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum ProjectStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED

  @@map("project_status")
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED

  @@map("task_status")
}

// Declaration order matters: ORDER BY priority DESC puts HIGH first.
enum TaskPriority {
  LOW
  MEDIUM
  HIGH

  @@map("task_priority")
}

enum AuditEntity {
  PROJECT
  TASK

  @@map("audit_entity")
}

enum AuditAction {
  CREATED
  UPDATED
  DELETED

  @@map("audit_action")
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  fullName     String     @map("full_name") @db.VarChar(100)
  email        String     @unique @db.VarChar(255)
  passwordHash String     @map("password_hash")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  projects     Project[]
  sessions     Session[]
  auditLogs    AuditLog[]

  @@map("users")
}

model Project {
  id          String        @id @default(uuid()) @db.Uuid
  ownerId     String        @map("owner_id") @db.Uuid
  owner       User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  key         String        @db.VarChar(10)
  name        String        @db.VarChar(120)
  description String?
  status      ProjectStatus @default(NOT_STARTED)
  startDate   DateTime?     @map("start_date") @db.Date
  endDate     DateTime?     @map("end_date") @db.Date
  taskSeq     Int           @default(0) @map("task_seq")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  tasks       Task[]
  auditLogs   AuditLog[]

  @@unique([ownerId, key])
  @@index([ownerId, status])
  @@index([ownerId, createdAt])
  @@map("projects")
}

model Task {
  id          String       @id @default(uuid()) @db.Uuid
  projectId   String       @map("project_id") @db.Uuid
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number      Int
  name        String       @db.VarChar(200)
  description String?
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(PENDING)
  dueDate     DateTime?    @map("due_date") @db.Date
  completedAt DateTime?    @map("completed_at") @db.Timestamptz(3)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([projectId, number])
  @@index([projectId, status])
  @@index([projectId, priority])
  @@index([projectId, dueDate])
  @@map("tasks")
}

model Session {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash  String    @map("refresh_token_hash")
  previousTokenHash String?   @map("previous_token_hash")
  rotatedAt         DateTime? @map("rotated_at") @db.Timestamptz(3)
  userAgent         String?   @map("user_agent") @db.VarChar(255)
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("sessions")
}

model AuditLog {
  id         String      @id @default(uuid()) @db.Uuid
  userId     String      @map("user_id") @db.Uuid
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId  String?     @map("project_id") @db.Uuid
  project    Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  entityType AuditEntity @map("entity_type")
  entityId   String      @map("entity_id") @db.Uuid
  action     AuditAction
  changes    Json?
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([projectId, createdAt(sort: Desc)])
  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("audit_logs")
}
