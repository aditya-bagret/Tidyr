# Copy to .env (development) and .env.test (tests). Never commit real values.
# TECHNICAL_REQUIREMENTS §11 describes each variable.

NODE_ENV=development
PORT=4000

# Local docker DB. Tests use the tidyr_test database instead.
# Neon: use the direct (non-pooled) connection string with ?sslmode=require
DATABASE_URL=postgresql://tidyr:tidyr@localhost:5432/tidyr

# At least 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=
# <n>s | <n>m | <n>h | <n>d
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_REUSE_GRACE_SECONDS=30

# 12 in development and production, 4 in tests
BCRYPT_ROUNDS=12

# Comma-separated web origins allowed by CORS
WEB_ORIGINS=http://localhost:3000

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_REGISTER_MAX=10
RATE_LIMIT_API_MAX=300
